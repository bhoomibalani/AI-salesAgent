DATABASE_URL=postgresql://postgres:postgres@localhost:5433/voice_sales_agent

# Demo UI: npm run web  →  http://localhost:3000
# PORT=3000

# RAG answers — pick one provider (embeddings stay local)
# Gemini (recommended if OpenAI quota is exhausted):
GEMINI_API_KEY=
RAG_PROVIDER=gemini
RAG_MODEL=gemini-3.6-flash

# Or OpenAI:
# RAG_PROVIDER=openai
# OPENAI_API_KEY=
# RAG_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional RAG tuning
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.28
# RAG_TEMPERATURE=0.2
# RAG_MAX_TOKENS=2048
# RAG_THINKING_LEVEL=minimal
# RAG_THINKING_BUDGET=0

# Optional default crawl target (override with: node index.js https://example.com)
# START_URL=https://openai.com

# Optional filters
# SEARCH_DOMAIN=openai.com
# EMBED_DOMAIN=openai.com
